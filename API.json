  "components": {
    "schemas": {
      "RegisterBasementRequestDto": {
        "type": "object",
        "properties": {
          "capacity": {
            "type": "number",
            "description": "Total capacity of the basement",
            "example": 100,
            "minimum": 1
          },
          "name": {
            "type": "string",
            "description": "Name of the basement",
            "example": "Basement A"
          }
        },
        "required": ["capacity"]
      },
      "RegisterBasementResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Basement unique identifier",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "description": "Name of the basement",
            "example": "Basement A"
          },
          "capacity": {
            "type": "number",
            "description": "Maximum capacity of the basement",
            "example": 100
          },
          "currentCount": {
            "type": "number",
            "description": "Current count of vehicles or occupants",
            "example": 0
          }
        },
        "required": ["id", "name", "capacity", "currentCount"]
      },
      "FindBasementResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Basement unique identifier",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "description": "Name of the basement",
            "example": "Basement A"
          },
          "capacity": {
            "type": "number",
            "description": "Maximum capacity of the basement",
            "example": 100
          },
          "currentCount": {
            "type": "number",
            "description": "Current vehicle / occupant count",
            "example": 45
          },
          "available": {
            "type": "number",
            "description": "Available remaining slots",
            "example": 55
          },
          "isFull": {
            "type": "boolean",
            "description": "Whether the basement is full",
            "example": false
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Last update timestamp",
            "example": "2026-11-10T10:00:00.000Z"
          }
        },
        "required": ["id", "name", "capacity", "currentCount", "available", "isFull", "updatedAt"]
      },
      "EditBasementRequestDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Basement unique identifier",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "description": "Name of the basement",
            "example": "Basement A"
          },
          "capacity": {
            "type": "number",
            "description": "Total capacity of the basement",
            "example": 120,
            "minimum": 1
          }
        },
        "required": ["id", "name", "capacity"]
      },
      "RegisterLineRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the line",
            "example": "Gate A Entrance"
          },
          "direction": {
            "type": "string",
            "description": "Direction mode of the line",
            "enum": ["in", "out", "both"],
            "example": "in"
          }
        },
        "required": ["name", "direction"]
      },
      "RegisterLineResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Line unique identifier",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "description": "Name of the line",
            "example": "Gate A Entrance"
          },
          "direction": {
            "type": "string",
            "description": "Direction mode of the line",
            "enum": ["in", "out", "both"],
            "example": "in"
          },
          "isActive": {
            "type": "boolean",
            "description": "Status indicating if the line is active",
            "example": true
          }
        },
        "required": ["id", "name", "direction", "isActive"]
      },
      "FindLineResponseDto": {
        "type": "object",
        "properties": {
          "id": {
